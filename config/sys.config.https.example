%% -*- mode: erlang;erlang-indent-level: 4;indent-tabs-mode: nil -*-
%% 
%% HTTPS/TLS生产环境配置示例
%% 
%% 使用说明：
%% 1. 复制此文件为 sys.config
%% 2. 修改证书路径、域名等配置
%% 3. 确保证书文件权限正确（600或644）
%% 4. 重启应用使配置生效
%%
[
    "config/db",
    {nova, [
        {environment, prod},
        
        %% HTTPS配置
        {cowboy_configuration, #{
            %% HTTP端口（可选，用于重定向到HTTPS）
            port => 8080,
            
            %% HTTPS配置
            ssl => #{
                %% HTTPS监听端口
                port => 8443,
                
                %% SSL/TLS证书配置
                %% 注意：请替换为实际的证书路径
                certfile => "/path/to/your/cert.pem",
                keyfile => "/path/to/your/key.pem",
                cacertfile => "/path/to/your/chain.pem",  %% 可选：证书链
                
                %% TLS版本配置
                %% 仅允许TLS 1.2和1.3，禁用旧版本协议
                versions => ['tlsv1.2', 'tlsv1.3'],
                
                %% 强加密套件配置
                %% 优先使用ECDHE和AEAD加密套件
                ciphers => [
                    %% TLS 1.3加密套件（推荐）
                    "TLS_AES_256_GCM_SHA384",
                    "TLS_AES_128_GCM_SHA256",
                    "TLS_CHACHA20_POLY1305_SHA256",
                    
                    %% TLS 1.2加密套件（向后兼容）
                    "ECDHE-ECDSA-AES256-GCM-SHA384",
                    "ECDHE-RSA-AES256-GCM-SHA384",
                    "ECDHE-ECDSA-AES128-GCM-SHA256",
                    "ECDHE-RSA-AES128-GCM-SHA256",
                    "ECDHE-ECDSA-CHACHA20-POLY1305",
                    "ECDHE-RSA-CHACHA20-POLY1305"
                ],
                
                %% 其他安全选项
                honor_cipher_order => true,      %% 优先使用服务器的加密套件顺序
                secure_renegotiate => true,      %% 安全重新协商
                reuse_sessions => true,          %% 会话重用（提高性能）
                verify => verify_none,           %% 客户端证书验证（根据需求调整）
                fail_if_no_peer_cert => false    %% 不强制要求客户端证书
            }
        }},
        
        {dev_mode, false},
        {bootstrap_application, eadm},
        {use_sessions, true},
        {session_expire, 3600},
        {secret_key, <<"请替换为随机生成的密钥">>},
        {max_search_span, 3},
        {max_fin_search_span, 366},
        {wx_key, "your-wx-key"},
        {push_token, "your-push-token"},
        {alipay_api_url, "https://openapi.alipay.com/gateway.do"},
        {alipay_app_id, ""},
        {alipay_private_key, ""},
        {alipay_public_key, ""},
        {wechat_api_url, "https://api.mch.weixin.qq.com"},
        {wechat_app_id, ""},
        {wechat_mch_id, ""},
        {wechat_api_key, ""},
        {wechat_api_v3_key, ""},
        {wechat_serial_no, ""},
        {wechat_private_key, ""},
        
        %% Nova插件配置
        {plugins, [
            {pre_request, nova_correlation_plugin, #{}},
            {pre_request, nova_request_plugin, #{
                decode_json_body => true,
                parse_bindings => true,
                read_urlencoded_body => true,
                parse_qs => true
            }},
            {pre_request, nova_cors_plugin, #{
                %% 生产环境应使用具体的域名，不要使用通配符
                allow_origins => [
                    <<"https://yourdomain.com">>,
                    <<"https://www.yourdomain.com">>
                ],
                allow_credentials => true,
                allow_methods => [<<"GET">>, <<"POST">>, <<"PUT">>, <<"DELETE">>, <<"OPTIONS">>],
                allow_headers => [
                    <<"Content-Type">>,
                    <<"X-Requested-With">>,
                    <<"Accept">>,
                    <<"Authorization">>
                ],
                expose_headers => [<<"*">>],
                max_age => 3600
            }},
            %% 添加安全响应头插件
            {post_request, eadm_security_headers_plugin, #{}}
        ]}
    ]},
    
    %% Lager日志配置
    {lager, [
        {log_root, "logs"},
        {handlers, [
            {lager_console_backend, [
                {level, info},
                {formatter, lager_default_formatter},
                {formatter_config, [
                    color, date, " ", time, " [", severity, "] ", node, "#", pid, " ", message, "\n"
                ]}
            ]},
            {lager_file_backend, [
                {file, "error.log"}, 
                {level, error}, 
                {size, 10485760},
                {date, "$D0"}, 
                {count, 5}
            ]},
            {lager_file_backend, [
                {file, "info.log"}, 
                {level, info}, 
                {size, 10485760},
                {date, "$D0"}, 
                {count, 5}
            ]},
            {lager_file_backend, [
                {file, "warning.log"}, 
                {level, warning}, 
                {size, 10485760},
                {date, "$D0"}, 
                {count, 5}
            ]}
        ]},
        {colored, true},
        {colors, [
            {debug, "\e[0:38m"},
            {info, "\e[1;32m"},
            {notice, "\e[1;36m"},
            {warning, "\e[1;33m"},
            {error, "\e[1;31m"},
            {critical, "\e[1;35m"},
            {alert, "\e[1;44m"},
            {emergency, "\e[1;41m"}
        ]},
        {crash_log, "crash.log"},
        {crash_log_msg_size, 65536},
        {crash_log_size, 10485760},
        {crash_log_date, "$D0"},
        {crash_log_count, 5}
    ]}
].
