[
    "config/db",
    {eadm, [
        %% SSL证书自动管理配置
        {ssl_enabled, false},  %% 设置为true启用SSL证书自动管理
        {ssl_domain, "eadm.wongcw.cn"},  %% 你的域名
        {ssl_email, "rubygreat@msn.com"},  %% 你的邮箱
        {ssl_validation, dns},  %% http 或 dns
        {ssl_cert_dir, "/opt/eadm/certs"},  %% 证书存储目录
        {cert_script, "/opt/eadm/docker/cert-manager.sh"},  %% 证书管理脚本路径
        
        %% DNS验证配置（仅当 ssl_validation 为 dns 时需要）
        {ssl_dns_provider, "dns_dp"},  %% DNS提供商: dns_ali, dns_cf, dns_dp, dns_tencent 等
        {ssl_dns_credentials, [
            {"DP_Id", "535906"},      %% DNSPod ID
            {"DP_Key", "7a5e1b6100d01cc7328b6955ef5c2d87"}   %% DNSPod Token
        ]},
        
        %% 证书检查间隔（毫秒），默认24小时
        {cert_check_interval, 86400000}
    ]},
    {nova, [
        {environment, dev},
        {cowboy_configuration, #{port => 8080}},
        {dev_mode, true},
        %% Bootstraps the application
        {bootstrap_application, eadm},
        {use_sessions, true},
        {session_expire, 3600},
        {secret_key, <<"aVkmcGh2qbLqtpY8NXqcUA==">>},
        {max_search_span, 3},
        {max_fin_search_span, 366},
        {wx_key, "9be2a47b-6d0d-4615-9dff-af5ed91f853d"},
        {push_token, "f9f695f545524ebd89927ddfbce5d9b1"},
        {plugins, [
            {pre_request, nova_correlation_plugin, #{}},
            {pre_request, nova_request_plugin, #{
                decode_json_body => true,
                parse_bindings => true,
                read_urlencoded_body => true,
                parse_qs => true
            }},
            {pre_request, nova_cors_plugin, #{
                allow_origins => [
                    <<"http://localhost:3000">>,
                    <<"http://127.0.0.1:3000">>,
                    <<"http://localhost:*">>,
                    <<"*">>
                ],
                allow_credentials => true,
                allow_methods => [<<"GET">>, <<"POST">>, <<"PUT">>, <<"DELETE">>, <<"OPTIONS">>],
                allow_headers => [
                    <<"*">>,
                    <<"Content-Type">>,
                    <<"X-Requested-With">>,
                    <<"Accept">>,
                    <<"Authorization">>
                ],
                expose_headers => [<<"*">>],
                max_age => 3600
            }}
        ]}
    ]},
    %% Lager Bein %%%
    {lager, [
        {log_root, "logs"},
        %% What handlers to install with what arguments
        {handlers, [
            {lager_console_backend, [
                {level, debug},
                {level, debug},
                {formatter, lager_default_formatter},
                {formatter_config, [
                    color,
                    date,
                    " ",
                    time,
                    " [",
                    severity,
                    "] ",
                    node,
                    " #",
                    pid,
                    " ",
                    message,
                    "\n"
                ]}
            ]},
            {lager_file_backend, [
                {file, "error.log"}, {level, error}, {size, 10485760}, {date, "$D0"}, {count, 999}
            ]},
            {lager_file_backend, [
                {file, "debug.log"}, {level, debug}, {size, 10485760}, {date, "$D0"}, {count, 999}
            ]}
        ]},
        {colored, true},
        {colors, [
            {debug, "\e[0:38m"},
            {info, "\e[1;32m"},
            {notice, "\e[1;36m"},
            {warning, "\e[1;33m"},
            {error, "\e[1;31m"},
            {critical, "\e[1;35m"},
            {alert, "\e[1;44m"},
            {emergency, "\e[1;41m"}
        ]}
    ]}
    %% Lager End %%%
].

%% Please change your app.src-file instead if you intend to add app-specific configurations
