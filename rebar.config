%% -*- mode: erlang;erlang-indent-level: 4;indent-tabs-mode: nil -*-

{erl_opts, [debug_info, {parse_transform, lager_transform}]}.
{src_dirs, ["src"]}.

%% Deps
{deps, [
    {cowboy, "2.15.0"},
    {cowlib, "2.17.1"},
    {ranch, "2.2.0"},
    {epgsql, ".*", {git, "https://github.com/epgsql/epgsql.git", {branch, "devel"}}},
    {poolboy, ".*", {git, "https://github.com/devinus/poolboy.git", {branch, "master"}}},
    {lager, ".*", {git, "https://github.com/erlang-lager/lager.git", {branch, "master"}}},
    {ecron, ".*", {git, "https://github.com/zhongwencool/ecron.git", {branch, "main"}}},
    {thoas, ".*", {git, "https://github.com/lpil/thoas.git", {branch, "main"}}}
    ]}.

%% Plugins for rebar3
{plugins, [
    {rebar3_ex_doc, ".*", {git, "https://github.com/jelly-beam/rebar3_ex_doc.git", {branch, "main"}}}
    ]}.

{ex_doc, [
    {extras, [
        {"README.md", #{title => "Overview"}},
        {"LICENSE", #{title => "License"}}
    ]},
    {main, "README.md"},
    {source_url, "https://github.com/redgreat/eadm"},
    {homepage_url, "https://www.wongcw.cn"}
]}.

%% Release profiles
%% To create a release just run
%% rebar3 as prod release
{relx, [{release, {eadm, "0.1.47"},
    [eadm, cowboy, epgsql, poolboy, lager, ecron, thoas, xmerl, sasl, inets, runtime_tools]},
    {mode, minimal},
    {extended_start_script, true},
    {sys_config, "config/sys.config"},
    {vm_args, "config/vm.args"},
    {overlay, [{mkdir, "priv"},
    {copy, "frontend/dist/", "priv/spa"}
    ]}
]}.

{profiles, [
    {prod, [{relx, [
        {mode, prod},
        {include_src, false},
        {include_erts, true},
        {debug_info, strip},
        {overlay, [{mkdir, "config"},
            {copy, "docker/db.config", "config/db.config"},
            {copy, "docker/sys.config", "config/sys.config"},
            {copy, "docker/vm.args", "config/vm.args"}
        ]}
    ]}]},
    {test, [
        {erl_opts, [debug_info, warnings_as_errors, {parse_transform, lager_transform}]},
        {cover_enabled, true},
        {cover_export_enabled, true}
    ]}
]}.

{eunit_opts, [verbose]}.
{xref_checks, [undefined_function_calls, undefined_functions, locals_not_used]}.
%% Historical ErlyDTL beams can survive rebar3 clean in an existing _build tree.
%% They are not part of the current application; ignore their runtime-only calls.
{xref_ignores, [erlydtl_filters, erlydtl_runtime]}.
{dialyzer, [
    {warnings, [unmatched_returns, error_handling, underspecs]},
    {plt_apps, top_level_deps},
    {plt_extra_apps, [crypto, inets]}
]}.

{shell, [
    {config, "config/dev_sys.config.src"},
    {ex_doc, "-f html --language zh"},
    {apps, [eadm]}
]}.

{minimum_otp_vsn, "27.2.3"}.
